{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!.ax",
      "!**/.ax",
      "!node_modules",
      "!workspace/worker-configuration.d.ts",
      "!skills/agent-workspace/scripts/generated-validators.cjs",
      "!skills/agent-workspace/scripts/generated-role-policies.json"
    ]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true
  },
  "assist": {
    "enabled": true
  }
}

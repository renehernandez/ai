#!/usr/bin/env bash
# Sets up or refreshes the AI toolchain on macOS from this repository's clean
# main checkout. Safe to re-run. Versions live in Brewfile, mise.toml, and
# ax.config.json; this script only runs their owners in order.
set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
step="argument parsing"

usage() {
  cat <<EOF
Usage: bin/bootstrap <profile>

Installs the Brewfile, the repo and global mise tools, and Pi packages, then
runs AX sync and validation for <profile> (a key of "profiles" in
ax.config.json, for example "personal" or "work").
EOF
}

fail() {
  echo "bootstrap: $*" >&2
  exit 1
}

begin() {
  step="$1"
  printf '\n==> %s\n' "$step"
}

removal_hint() {
  local resolved prefix="" package
  resolved="$(realpath "$1")"
  [[ "$resolved" == */mise/installs/* ]] && prefix="mise exec -- "
  if [[ "$resolved" == */lib/node_modules/* ]]; then
    package="${resolved#*/lib/node_modules/}"
    # Scoped packages keep two path segments: @scope/name.
    if [[ "$package" == @* ]]; then
      package="$(cut -d/ -f1-2 <<<"$package")"
    else
      package="${package%%/*}"
    fi
    echo "remove with: ${prefix}npm uninstall -g $package"
  elif [[ "$resolved" == */Cellar/* ]]; then
    echo "remove with: brew uninstall $(cut -d/ -f1 <<<"${resolved#*/Cellar/}")"
  else
    echo "remove it with the tool that installed it"
  fi
}

trap 'echo "bootstrap failed during: $step" >&2' ERR

case "${1:-}" in
  -h | --help)
    usage
    exit 0
    ;;
  "")
    usage >&2
    exit 1
    ;;
esac
profile="$1"
[[ $# -eq 1 ]] || fail "expected exactly one profile argument"
[[ "$profile" =~ ^[a-z0-9-]+$ ]] || fail "invalid profile name: $profile"
plutil -extract "profiles.$profile" json -o - "$repo/ax.config.json" >/dev/null 2>&1 ||
  fail "unknown profile \"$profile\"; see \"profiles\" in ax.config.json"

begin "Homebrew bundle"
command -v brew >/dev/null || fail "Homebrew is required: https://brew.sh"
brew bundle --file "$repo/Brewfile"

begin "Repository tools and setup"
mise trust "$repo/mise.toml"
mise -C "$repo" install
mise -C "$repo" run setup

begin "AX shim and runtime sync"
mise -C "$repo" exec -- pnpm ax shim install
mise -C "$repo" exec -- pnpm ax sync --profile "$profile"

begin "Global mise tools"
mise -C "$HOME" install

begin "Pi packages"
mise -C "$repo" exec -- pnpm run pi:packages-install

begin "Validation"
mise -C "$repo" exec -- pnpm ax validate
# Each executable and the mise tool that pins it.
for entry in node=node pnpm=pnpm pi=npm:@earendil-works/pi-coding-agent openspec=npm:@fission-ai/openspec; do
  tool="${entry%%=*}"
  owner="${entry#*=}"
  pinned="$(mise -C "$HOME" current "$owner")"
  version="$(mise -C "$HOME" exec -- "$tool" --version)"
  resolved="$(mise -C "$HOME" which "$tool")"
  printf '%s %s (%s)\n' "$tool" "$version" "$resolved"
  # A global npm package inside a mise Node install can shadow the pinned tool.
  [[ "$version" == *"$pinned"* ]] ||
    fail "$tool at $resolved shadows the pinned $owner@$pinned; $(removal_hint "$resolved")"
  seen=" "
  while IFS= read -r other; do
    [[ "$other" == "$resolved" || "$other" == */mise/* || "$seen" == *" $other "* ]] && continue
    seen+="$other "
    echo "  another $tool is on PATH at $other; mise's copy wins only where mise is active ($(removal_hint "$other"))"
  done < <(type -ap "$tool")
done

step="completion"
cat <<EOF

Bootstrap complete for profile "$profile".
Remaining manual steps:
  - Restart Paseo so it picks up the new PATH.
  - Sign in where needed: claude (Claude Code), codex login, and Pi's /login.
EOF

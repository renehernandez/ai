{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rene.local/agents/workspace-record.schema.json",
  "oneOf": [
    { "$ref": "#/$defs/root" },
    { "$ref": "#/$defs/memory" },
    { "$ref": "#/$defs/workstream" },
    { "$ref": "#/$defs/run" },
    { "$ref": "#/$defs/decision" },
    { "$ref": "#/$defs/escalation" }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": [
        "record_type",
        "id",
        "created_at",
        "classification",
        "summary"
      ],
      "properties": {
        "record_type": { "type": "string" },
        "id": { "type": "string", "minLength": 1 },
        "created_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "classification": {
          "enum": ["public", "internal", "confidential", "restricted"]
        },
        "summary": { "type": "string", "maxLength": 20000 },
        "source_links": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9+.-]*:.+$"
          }
        },
        "next_check_at": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        }
      }
    },
    "root": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "record_type",
            "id",
            "created_at",
            "classification",
            "summary",
            "agent_key",
            "agent_role",
            "reports_to",
            "owned_scope",
            "workspace_generation",
            "activation_state",
            "prompt_contract_version",
            "rendered_prompt_sha256",
            "model_profile",
            "runtime_backend",
            "workspace_key",
            "runtime_agent_id",
            "codex_task_id",
            "memory_epoch_id"
          ],
          "properties": {
            "record_type": { "const": "root" },
            "id": true,
            "created_at": true,
            "classification": true,
            "summary": true,
            "source_links": true,
            "next_check_at": true,
            "agent_key": { "type": "string" },
            "agent_role": { "type": "string" },
            "reports_to": { "type": "string" },
            "owned_scope": { "type": "string" },
            "workspace_generation": { "type": "integer", "minimum": 1 },
            "activation_state": { "enum": ["active", "inactive"] },
            "prompt_contract_version": { "type": "string" },
            "rendered_prompt_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "model_profile": { "type": "string" },
            "runtime_backend": { "const": "cloudflare-flue-v1" },
            "workspace_key": { "type": "string", "minLength": 1 },
            "runtime_agent_id": { "type": "string", "minLength": 1 },
            "authority_exclusions": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string" }
            },
            "codex_task_id": { "type": "null" },
            "memory_epoch_id": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "memory": { "$ref": "#/$defs/simpleMemory" },
    "simpleMemory": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "record_type",
            "id",
            "created_at",
            "classification",
            "summary",
            "epoch",
            "current",
            "prompt_contract_version",
            "charter_summary",
            "constraints",
            "decisions",
            "workstream_ids"
          ],
          "properties": {
            "record_type": { "const": "memory" },
            "id": true,
            "created_at": true,
            "classification": true,
            "summary": true,
            "source_links": true,
            "next_check_at": true,
            "epoch": { "type": "integer", "minimum": 1 },
            "current": { "type": "boolean" },
            "prompt_contract_version": { "type": "string" },
            "charter_summary": { "type": "string" },
            "constraints": {
              "type": "array",
              "items": { "type": "string" }
            },
            "decisions": {
              "type": "array",
              "items": { "type": "string" }
            },
            "workstream_ids": {
              "type": "array",
              "items": { "type": "string" }
            },
            "prior_epoch_id": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "workstream": { "$ref": "#/$defs/simpleWorkstream" },
    "simpleWorkstream": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "record_type",
            "id",
            "created_at",
            "classification",
            "summary",
            "outcome",
            "status",
            "owner",
            "scope",
            "acceptance",
            "dependencies",
            "risks",
            "next_action"
          ],
          "properties": {
            "record_type": { "const": "workstream" },
            "id": true,
            "created_at": true,
            "classification": true,
            "summary": true,
            "source_links": true,
            "next_check_at": true,
            "status": {
              "enum": [
                "planned",
                "active",
                "blocked",
                "waiting",
                "complete",
                "canceled"
              ]
            },
            "owner": { "type": "string" },
            "outcome": { "type": "string" },
            "scope": { "type": "string" },
            "acceptance": {
              "type": "array",
              "items": { "type": "string" }
            },
            "dependencies": {
              "type": "array",
              "items": { "type": "string" }
            },
            "risks": {
              "type": "array",
              "items": { "type": "string" }
            },
            "next_action": { "type": "string" }
          }
        }
      ]
    },
    "run": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "record_type",
            "id",
            "created_at",
            "classification",
            "summary",
            "invocation_id",
            "state",
            "workspace_generation",
            "role_variant",
            "model_profile",
            "model_routing_reason",
            "sandbox_mode",
            "tool_policy_attestation",
            "mode",
            "authority_grant",
            "canonical_sources",
            "objective",
            "acceptance",
            "verification",
            "stop_condition",
            "escalation_route",
            "attempt"
          ],
          "properties": {
            "record_type": { "const": "run" },
            "id": true,
            "created_at": true,
            "classification": true,
            "summary": true,
            "source_links": true,
            "next_check_at": true,
            "invocation_id": { "type": "string" },
            "state": {
              "enum": [
                "reserved",
                "spawned",
                "active",
                "complete",
                "canceled",
                "failed"
              ]
            },
            "workspace_generation": { "type": "integer", "minimum": 1 },
            "role_variant": { "type": "string" },
            "model_profile": { "type": "string" },
            "model_routing_reason": { "type": "string" },
            "sandbox_mode": { "enum": ["read-only", "workspace-write"] },
            "tool_policy_attestation": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "mode": {
              "enum": ["Explore", "Plan", "Execute", "Review", "Finish"]
            },
            "authority_grant": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string" }
            },
            "canonical_sources": {
              "type": "array",
              "items": { "type": "string" }
            },
            "objective": { "type": "string" },
            "acceptance": {
              "type": "array",
              "items": { "type": "string" }
            },
            "verification": {
              "type": "array",
              "items": { "type": "string" }
            },
            "stop_condition": { "type": "string" },
            "escalation_route": { "type": "string" },
            "attempt": { "type": "integer", "minimum": 1 },
            "worktree": { "type": ["string", "null"] },
            "head": { "type": ["string", "null"] },
            "handoff": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "decision": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "record_type",
            "id",
            "created_at",
            "classification",
            "summary",
            "question",
            "evidence",
            "owner",
            "status"
          ],
          "properties": {
            "record_type": { "const": "decision" },
            "id": true,
            "created_at": true,
            "classification": true,
            "summary": true,
            "source_links": true,
            "next_check_at": true,
            "status": {
              "enum": [
                "requested",
                "approved",
                "rejected",
                "expired",
                "consumed"
              ]
            },
            "question": { "type": "string" },
            "evidence": {
              "type": "array",
              "items": { "type": "string" }
            },
            "owner": { "type": "string" },
            "action_type": { "type": ["string", "null"] },
            "destination": { "type": ["string", "null"] },
            "fingerprint": {
              "type": ["string", "null"],
              "pattern": "^[a-f0-9]{64}$"
            },
            "origin_event_id": { "type": ["string", "null"] },
            "actor_id": { "type": ["string", "null"] },
            "approved_at": { "type": ["string", "null"] },
            "expires_at": { "type": ["string", "null"] },
            "consumed_at": { "type": ["string", "null"] },
            "result": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "escalation": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "record_type",
            "id",
            "created_at",
            "classification",
            "summary",
            "attention",
            "impact",
            "evidence",
            "attempted_mitigations",
            "required_action",
            "owner"
          ],
          "properties": {
            "record_type": { "const": "escalation" },
            "id": true,
            "created_at": true,
            "classification": true,
            "summary": true,
            "source_links": true,
            "next_check_at": true,
            "attention": { "enum": ["blocked", "urgent", "waiting_on_rene"] },
            "impact": { "type": "string" },
            "evidence": {
              "type": "array",
              "items": { "type": "string" }
            },
            "attempted_mitigations": {
              "type": "array",
              "items": { "type": "string" }
            },
            "required_action": { "type": "string" },
            "owner": { "type": "string" },
            "deadline": {
              "type": ["string", "null"],
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
            }
          }
        }
      ]
    }
  }
}

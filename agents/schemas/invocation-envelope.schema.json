{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rene.local/agents/invocation-envelope.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "message_id",
    "message_type",
    "correlation_id",
    "sender",
    "recipient",
    "workspace_generation",
    "mode",
    "objective",
    "authority_grant",
    "canonical_sources",
    "acceptance",
    "verification",
    "stop_condition",
    "model_profile",
    "escalation_route",
    "next_check_at"
  ],
  "properties": {
    "message_id": { "type": "string", "minLength": 1 },
    "message_type": {
      "enum": [
        "ASSIGN",
        "ACK",
        "CHECKPOINT",
        "DECISION_REQUEST",
        "BLOCKED",
        "URGENT",
        "HANDOFF",
        "COMPLETE",
        "CANCEL"
      ]
    },
    "correlation_id": { "type": "string", "minLength": 1 },
    "sender": { "type": "string", "minLength": 1 },
    "recipient": { "type": "string", "minLength": 1 },
    "agent_run_id": { "type": ["string", "null"] },
    "workspace_generation": { "type": "integer", "minimum": 1 },
    "mode": { "enum": ["Explore", "Plan", "Execute", "Review", "Finish"] },
    "objective": { "type": "string", "minLength": 1 },
    "authority_grant": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "canonical_sources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "stop_condition": { "type": "string", "minLength": 1 },
    "model_profile": { "type": "string", "minLength": 1 },
    "escalation_route": { "type": "string", "minLength": 1 },
    "next_check_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "delivery_state": {
      "enum": ["pending", "delivered", "acknowledged", "failed"]
    },
    "attempt": { "type": "integer", "minimum": 1 }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rene.local/agents/manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prompt_contract_version",
    "shared_contract",
    "model_profiles",
    "roles",
    "reviewer_overlays",
    "outputs"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "prompt_contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "shared_contract": { "$ref": "#/$defs/relativeMarkdownPath" },
    "model_profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/modelProfile" }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/role" }
    },
    "reviewer_overlays": {
      "type": "array",
      "items": { "$ref": "#/$defs/overlay" }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/output" }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "relativeMarkdownPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9._/-]+\\.md$"
    },
    "modelProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "reasoning_effort",
        "automatic_ceiling",
        "manual_only"
      ],
      "properties": {
        "model": { "type": "string", "pattern": "^gpt-[a-zA-Z0-9.-]+$" },
        "reasoning_effort": { "$ref": "#/$defs/reasoning" },
        "automatic_ceiling": { "$ref": "#/$defs/reasoning" },
        "manual_only": { "type": "boolean" }
      }
    },
    "reasoning": {
      "enum": ["low", "medium", "high", "xhigh", "max", "ultra"]
    },
    "lifecycle": { "enum": ["pinned", "ephemeral"] },
    "sandbox": { "enum": ["read-only", "workspace-write"] },
    "capability": {
      "enum": [
        "linear:coordinate",
        "codex:coordinate",
        "provider:read",
        "provider:draft",
        "finish:draft",
        "repository:write",
        "review:read"
      ]
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "lifecycle",
        "reports_to",
        "charter",
        "model_profile",
        "allowed_profiles",
        "sandbox_mode",
        "capabilities",
        "required_skills"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "description": { "type": "string", "minLength": 20 },
        "lifecycle": { "$ref": "#/$defs/lifecycle" },
        "reports_to": { "type": ["string", "null"] },
        "charter": { "$ref": "#/$defs/relativeMarkdownPath" },
        "model_profile": { "$ref": "#/$defs/identifier" },
        "allowed_profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "sandbox_mode": { "$ref": "#/$defs/sandbox" },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/capability" }
        },
        "required_skills": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "path": { "$ref": "#/$defs/relativeMarkdownPath" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "kind"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "role": { "$ref": "#/$defs/identifier" },
        "kind": {
          "enum": ["pinned_prompt_bundle", "codex_custom_agent"]
        },
        "model_profile": { "$ref": "#/$defs/identifier" },
        "reviewer_overlays": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    }
  }
}

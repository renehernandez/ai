{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rene.local/agents/workspace-operation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "workspace_key",
    "agent_key",
    "workspace_generation",
    "message_type",
    "objective",
    "mode",
    "authority_grant",
    "canonical_sources",
    "acceptance",
    "verification",
    "stop_condition",
    "escalation_route",
    "model_profile",
    "sandbox_mode",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "operation_id": { "type": "string", "minLength": 1 },
    "workspace_key": { "type": "string", "minLength": 1 },
    "agent_key": { "type": "string", "minLength": 1 },
    "workspace_generation": { "type": "integer", "minimum": 1 },
    "message_type": {
      "enum": [
        "ASSIGN",
        "CHECKPOINT",
        "DECISION_REQUEST",
        "BLOCKED",
        "URGENT",
        "HANDOFF",
        "COMPLETE",
        "CANCEL"
      ]
    },
    "objective": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["Explore", "Plan", "Execute", "Review", "Finish"] },
    "authority_grant": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "canonical_sources": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "acceptance": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "verification": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "stop_condition": { "type": "string", "minLength": 1 },
    "escalation_route": { "type": "string", "minLength": 1 },
    "model_profile": { "type": "string", "minLength": 1 },
    "sandbox_mode": { "enum": ["read-only", "workspace-write"] },
    "repo_path": { "type": ["string", "null"] },
    "correlation_id": { "type": ["string", "null"] },
    "idempotency_id": { "type": ["string", "null"] },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}

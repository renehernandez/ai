{
  "version": 1,
  "runtime": {
    "canonicalSkillsDir": "~/.agents/skills",
    "skillSymlinkTargets": ["~/.claude/skills"],
    "reusableScripts": [
      "scripts/nitro-feedback-gate.ts",
      "scripts/planning-contracts.ts",
      "scripts/review-gate.ts",
      "scripts/stack-state.ts"
    ],
    "instructionSymlinkTargets": {
      "agents": "~/.agents",
      "claude": "~/.claude",
      "codex": "~/.codex"
    },
    "hooks": {
      "sourceDir": "/Users/rene.hernandez/work/projects/rene.hernandez/ai/hooks",
      "canonicalDir": "~/.agents/hooks",
      "targets": {
        "claude": "~/.claude/hooks",
        "codex": "~/.codex/hooks"
      }
    },
    "openspec": {
      "tools": ["codex", "claude"],
      "canonicalSkillsDir": ".agents/skills",
      "canonicalCommandsDir": ".agents/commands",
      "skillTargets": {
        "codex": ".codex/skills",
        "claude": ".claude/skills"
      },
      "commandTargets": {
        "claude": ".claude/commands"
      }
    }
  },
  "profiles": {
    "personal": {
      "include": ["personal-skills", "cloudflare"],
      "paths": [
        {
          "sourcePath": "instructions/AGENTS.md",
          "targetPath": "AGENTS.md"
        },
        "rules/agent-surface-routing.md",
        "rules/command-and-tools.md",
        "rules/confidence.md",
        "rules/dependency-security.md",
        "rules/docs-and-specs.md",
        "rules/git-and-review.md",
        "rules/handoff-and-resume.md",
        "rules/investigation-and-implementation.md",
        "rules/session-startup.md"
      ]
    },
    "work": {
      "include": ["personal-skills", "cloudflare", "fullscript"],
      "paths": [
        {
          "sourcePath": "instructions/AGENTS.md",
          "targetPath": "AGENTS.md"
        },
        "rules/agent-surface-routing.md",
        "rules/ci-infra-and-cloudflare.md",
        "rules/command-and-tools.md",
        "rules/confidence.md",
        "rules/dependency-security.md",
        "rules/docs-and-specs.md",
        "rules/fullscript/nitro-review.md",
        "rules/git-and-review.md",
        "rules/handoff-and-resume.md",
        "rules/investigation-and-implementation.md",
        "rules/session-startup.md"
      ]
    }
  },
  "blocks": {
    "personal-skills": {
      "skills": [
        {
          "localPath": "skills",
          "names": ["*"]
        }
      ]
    },
    "cloudflare": {
      "skills": [
        {
          "url": "https://github.com/cloudflare/skills.git",
          "ref": "main",
          "basePath": "skills",
          "names": [
            "agents-sdk",
            "cloudflare",
            "durable-objects",
            "sandbox-sdk",
            "web-perf",
            "workers-best-practices",
            "wrangler"
          ]
        }
      ]
    },
    "fullscript": {
      "skills": [
        {
          "url": "https://git.fullscript.io/ai/skills.git",
          "ref": "main",
          "basePath": ".",
          "names": [
            "gitlab-ci",
            "glab-cli",
            "glab-stacked-diffs",
            "legoland",
            "terraform"
          ]
        }
      ]
    }
  }
}

{
  "version": 1,
  "runtime": {
    "retiredSkills": [
      "agent-workspace",
      "codex-review-feedback",
      "compound",
      "github-pr-create",
      "glab-mr-create",
      "handoff-brief",
      "merge-followthrough",
      "paseo-orchestration",
      "plan-coordinate",
      "plan-delivery",
      "plan-orchestrator",
      "plan-poc",
      "plan-ready",
      "plan-review",
      "plan-to-review",
      "plan-unit-delivery",
      "plan-unit-sequencer",
      "review-feedback-routing",
      "sandbox-sdk",
      "session-start"
    ],
    "canonicalSkillsDir": "~/.agents/skills",
    "skillSymlinkTargets": [
      "~/.codex/skills",
      "~/.claude/skills",
      "~/.pi/agent/skills"
    ],
    "instructionSymlinkTargets": {
      "agents": "~/.agents",
      "claude": "~/.claude",
      "codex": "~/.codex",
      "pi": "~/.pi/agent"
    },
    "hooks": {
      "sourceDir": "hooks",
      "canonicalDir": "~/.agents/hooks",
      "targets": {
        "claude": "~/.claude/hooks",
        "codex": "~/.codex/hooks"
      },
      "registrations": [
        {
          "id": "block-agent-force-push",
          "event": "PreToolUse",
          "matcher": "^Bash$",
          "command": "pnpm exec tsx ~/.agents/hooks/block-agent-force-push.ts",
          "targets": {
            "claude": "~/.claude/settings.json",
            "codex": "~/.codex/hooks.json"
          }
        },
        {
          "id": "block-delete-outside-cwd",
          "event": "PreToolUse",
          "matcher": "^Bash$",
          "command": "pnpm exec tsx ~/.agents/hooks/block-delete-outside-cwd.ts",
          "targets": {
            "claude": "~/.claude/settings.json",
            "codex": "~/.codex/hooks.json"
          }
        }
      ]
    },
    "configs": {
      "herdrApp": {
        "target": "~/.config/herdr-app"
      },
      "herdrKeys": {
        "target": "~/.config/herdr-app/keys.json",
        "managedPaths": [
          {
            "path": ["global", "cmd-k p"],
            "value": "mod.open:projects-edit"
          }
        ]
      },
      "herdrTemplates": {
        "target": "~/.config/herdr-core/templates"
      },
      "mise": {
        "target": "~/.config/mise/config.toml",
        "managed": {
          "tools": {
            "node": "26.3.0",
            "pnpm": "12.16.1",
            "npm:@earendil-works/pi-coding-agent": "1.5.0",
            "npm:@fission-ai/openspec": "1.15.0"
          }
        }
      },
      "pi": {
        "target": "~/.pi/agent/settings.json",
        "managedPaths": [
          { "path": ["defaultProvider"], "value": "claude-bridge" },
          { "path": ["defaultModel"], "value": "claude-opus-5-5" },
          { "path": ["defaultThinkingLevel"], "value": "medium" },
          {
            "path": ["packages"],
            "value": "npm:pi-claude-bridge@0.9.3",
            "merge": "append-unique"
          },
          { "path": ["retry", "enabled"], "value": false },
          { "path": ["retry", "provider", "maxRetries"], "value": 0 },
          { "path": ["retry", "provider", "timeoutMs"], "value": 300000 }
        ]
      },
      "piClaudeBridge": {
        "target": "~/.pi/agent/claude-bridge.json",
        "managedPaths": [
          { "path": ["askClaude", "enabled"], "value": false },
          { "path": ["askClaude", "allowFullMode"], "value": false },
          { "path": ["provider", "plan"], "value": "pro" },
          {
            "path": ["provider", "longContextExtraUsage"],
            "value": false
          },
          {
            "path": ["provider", "forceTwoHundredK"],
            "value": [
              "claude-opus-5-5",
              "claude-sonnet-5-5",
              "claude-fable-5-1"
            ]
          },
          { "path": ["provider", "strictMcpConfig"], "value": true },
          { "path": ["provider", "autoMemoryEnabled"], "value": false }
        ]
      },
      "piModels": {
        "target": "~/.pi/agent/models.json",
        "managedPaths": [
          {
            "path": [
              "providers",
              "cloudflare-ai-gateway",
              "modelOverrides",
              "workers-ai/@cf/deepseek-ai/deepseek-v4-flash-0731",
              "maxTokens"
            ],
            "value": 32768
          },
          {
            "path": [
              "providers",
              "cloudflare-ai-gateway",
              "modelOverrides",
              "workers-ai/@cf/deepseek-ai/deepseek-v4-flash-0731",
              "compat",
              "supportsReasoningEffort"
            ],
            "value": true
          },
          {
            "path": [
              "providers",
              "cloudflare-ai-gateway",
              "modelOverrides",
              "workers-ai/@cf/deepseek-ai/deepseek-v4-flash-0731",
              "thinkingLevelMap"
            ],
            "value": {
              "off": null,
              "minimal": null,
              "low": "low",
              "medium": "medium",
              "high": "high",
              "xhigh": null,
              "max": null
            }
          },
          {
            "path": [
              "providers",
              "cloudflare-ai-gateway",
              "modelOverrides",
              "workers-ai/@cf/zai-org/glm-5.3",
              "maxTokens"
            ],
            "value": 32768
          },
          {
            "path": [
              "providers",
              "cloudflare-ai-gateway",
              "modelOverrides",
              "workers-ai/@cf/zai-org/glm-5.3",
              "contextWindow"
            ],
            "value": 1048576
          },
          {
            "path": [
              "providers",
              "cloudflare-ai-gateway",
              "modelOverrides",
              "workers-ai/@cf/zai-org/glm-5.3",
              "compat",
              "supportsReasoningEffort"
            ],
            "value": true
          },
          {
            "path": [
              "providers",
              "cloudflare-ai-gateway",
              "modelOverrides",
              "workers-ai/@cf/zai-org/glm-5.3",
              "thinkingLevelMap"
            ],
            "value": {
              "off": null,
              "minimal": null,
              "low": "low",
              "medium": null,
              "high": "high",
              "xhigh": null,
              "max": "max"
            }
          }
        ]
      },
      "codex": {
        "target": "~/.codex/config.toml",
        "managed": {
          "features": {
            "memories": true,
            "multi_agent_v2": {
              "enabled": true,
              "max_concurrent_threads_per_session": 10
            }
          },
          "agents": {
            "max_depth": 1
          },
          "memories": {
            "generate_memories": true,
            "use_memories": true
          }
        }
      }
    },
    "openspec": {
      "tools": ["codex", "claude"],
      "canonicalSkillsDir": ".agents/skills",
      "canonicalCommandsDir": ".agents/commands",
      "skillTargets": {
        "codex": ".codex/skills",
        "claude": ".claude/skills"
      },
      "commandTargets": {
        "claude": ".claude/commands"
      }
    }
  },
  "profiles": {
    "personal": {
      "include": ["personal-skills", "cloudflare"],
      "paths": [
        {
          "sourcePath": "instructions/AGENTS.md",
          "targetPath": "AGENTS.md"
        },
        "rules/agent-surface-routing.md",
        "rules/agent-development-workflow-charter.md",
        "rules/command-and-tools.md",
        "rules/communication.md",
        "rules/confidence.md",
        "rules/dependency-security.md",
        "rules/docs-and-specs.md",
        "rules/git-and-review.md",
        "rules/handoff-and-resume.md",
        "rules/investigation-and-implementation.md",
        "rules/session-startup.md"
      ]
    },
    "work": {
      "include": ["personal-skills", "cloudflare", "fullscript"],
      "paths": [
        {
          "sourcePath": "instructions/AGENTS.md",
          "targetPath": "AGENTS.md"
        },
        "rules/agent-surface-routing.md",
        "rules/agent-development-workflow-charter.md",
        "rules/ci-infra-and-cloudflare.md",
        "rules/command-and-tools.md",
        "rules/communication.md",
        "rules/confidence.md",
        "rules/dependency-security.md",
        "rules/docs-and-specs.md",
        "rules/fullscript/nitro-review.md",
        "rules/git-and-review.md",
        "rules/handoff-and-resume.md",
        "rules/investigation-and-implementation.md",
        "rules/session-startup.md"
      ]
    }
  },
  "blocks": {
    "personal-skills": {
      "skills": [
        {

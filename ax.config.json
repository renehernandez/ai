    "canonicalSkillsDir": "~/.agents/skills",
    "skillSymlinkTargets": [
      "~/.codex/skills",
      "~/.claude/skills",
      "~/.pi/agent/skills"
    ],
    "instructionSymlinkTargets": {
      "agents": "~/.agents",
      "claude": "~/.claude",
      "codex": "~/.codex",
      "pi": "~/.pi/agent"
    },
    "hooks": {
      "sourceDir": "hooks",
      "canonicalDir": "~/.agents/hooks",
      "targets": {
        "claude": "~/.claude/hooks",
        "codex": "~/.codex/hooks"
      },
      "registrations": [
        {
          "id": "block-agent-force-push",
          "event": "PreToolUse",
          "matcher": "^Bash$",
          "command": "pnpm exec tsx ~/.agents/hooks/block-agent-force-push.ts",
          "targets": {
            "claude": "~/.claude/settings.json",
            "codex": "~/.codex/hooks.json"
          }
        },
        {
          "id": "block-delete-outside-cwd",
          "event": "PreToolUse",
          "matcher": "^Bash$",
          "command": "pnpm exec tsx ~/.agents/hooks/block-delete-outside-cwd.ts",
          "targets": {
            "claude": "~/.claude/settings.json",
            "codex": "~/.codex/hooks.json"
          }
        }
      ]
    },
    "configs": {
      "pi": {
        "target": "~/.pi/agent/settings.json",
        "managedPaths": [
          { "path": ["defaultProvider"], "value": "claude-bridge" },
          { "path": ["defaultModel"], "value": "claude-opus-5-5" },
          { "path": ["defaultThinkingLevel"], "value": "medium" },
          {
            "path": ["packages"],
            "value": "npm:pi-claude-bridge@0.8.0",
            "merge": "append-unique"
          },
          { "path": ["retry", "enabled"], "value": false },
          { "path": ["retry", "provider", "maxRetries"], "value": 0 },
          { "path": ["retry", "provider", "timeoutMs"], "value": 300000 }
        ]
      },
      "piClaudeBridge": {
        "target": "~/.pi/agent/claude-bridge.json",
        "managedPaths": [
          { "path": ["askClaude", "enabled"], "value": false },
          { "path": ["askClaude", "allowFullMode"], "value": false },
          { "path": ["provider", "plan"], "value": "pro" },
          {
            "path": ["provider", "longContextExtraUsage"],
            "value": false
          },
          {
            "path": ["provider", "forceTwoHundredK"],
            "value": ["claude-opus-5-5"]
          },
          { "path": ["provider", "strictMcpConfig"], "value": true },
          { "path": ["provider", "autoMemoryEnabled"], "value": false }

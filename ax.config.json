{
  "version": 1,
  "runtime": {
    "retiredSkills": [
      "agent-workspace",
      "codex-review-feedback",
      "compound",
      "github-pr-create",
      "glab-mr-create",
      "merge-followthrough",
      "plan-coordinate",
      "plan-delivery",
      "plan-orchestrator",
      "plan-poc",
      "plan-ready",
      "plan-review",
      "plan-to-review",
      "plan-unit-delivery",
      "plan-unit-sequencer",
      "review-feedback-routing",
      "session-start"
    ],
    "canonicalSkillsDir": "~/.agents/skills",
    "skillSymlinkTargets": ["~/.codex/skills", "~/.claude/skills"],
    "instructionSymlinkTargets": {
      "agents": "~/.agents",
      "claude": "~/.claude",
      "codex": "~/.codex"
    },
    "hooks": {
      "sourceDir": "hooks",
      "canonicalDir": "~/.agents/hooks",
      "targets": {
        "claude": "~/.claude/hooks",
        "codex": "~/.codex/hooks"
      },
      "registrations": [
        {
          "id": "block-delete-outside-cwd",
          "event": "PreToolUse",
          "matcher": "^Bash$",
          "command": "pnpm exec tsx ~/.agents/hooks/block-delete-outside-cwd.ts",
          "targets": {
            "claude": "~/.claude/settings.json",
            "codex": "~/.codex/hooks.json"
          }
        }
      ]
    },
    "configs": {
      "codex": {
        "target": "~/.codex/config.toml",
        "managed": {
          "features": {
            "memories": true,
            "multi_agent_v2": {
              "enabled": true,
              "max_concurrent_threads_per_session": 10
            }
          },
          "agents": {
            "max_depth": 1
          },
          "memories": {
            "generate_memories": true,
            "use_memories": true
          }
        }
      }
    },
    "openspec": {
      "tools": ["codex", "claude"],
      "canonicalSkillsDir": ".agents/skills",
      "canonicalCommandsDir": ".agents/commands",
      "skillTargets": {
        "codex": ".codex/skills",
        "claude": ".claude/skills"
      },
      "commandTargets": {
        "claude": ".claude/commands"
      }
    }
  },
  "profiles": {
    "personal": {
      "include": ["personal-skills", "cloudflare"],
      "paths": [
        {
          "sourcePath": "instructions/AGENTS.md",
          "targetPath": "AGENTS.md"
        },
        "rules/agent-surface-routing.md",
        "rules/agent-development-workflow-charter.md",
        "rules/command-and-tools.md",
        "rules/communication.md",
        "rules/confidence.md",
        "rules/dependency-security.md",
        "rules/docs-and-specs.md",
        "rules/git-and-review.md",
        "rules/handoff-and-resume.md",
        "rules/investigation-and-implementation.md",
        "rules/session-startup.md"
      ]
    },
    "work": {
      "include": ["personal-skills", "cloudflare", "fullscript"],
      "paths": [
        {
          "sourcePath": "instructions/AGENTS.md",
          "targetPath": "AGENTS.md"
        },
        "rules/agent-surface-routing.md",
        "rules/agent-development-workflow-charter.md",
        "rules/ci-infra-and-cloudflare.md",
        "rules/command-and-tools.md",
        "rules/communication.md",
        "rules/confidence.md",
        "rules/dependency-security.md",
        "rules/docs-and-specs.md",
        "rules/fullscript/nitro-review.md",
        "rules/git-and-review.md",
        "rules/handoff-and-resume.md",
        "rules/investigation-and-implementation.md",
        "rules/session-startup.md"
      ]
    }
  },
  "blocks": {
    "personal-skills": {
      "skills": [
        {
          "localPath": "skills",
          "names": [
            "ai-readiness-upkeep",
            "ax-cli",
            "brainstorming",
            "change-request-create",
            "code-quality-review",
            "code-simplifier",
            "deslop",
            "diff-review",
            "doc-smith",
            "docs-alignment-review",
            "execute",
            "explain-diff-html",
            "explore",
            "finish",
            "github-adapter-review",
            "gitlab-adapter-review",
            "glab-stacked-diffs",
            "handoff-brief",
            "linear-breakdown",
            "linear-project-overview",
            "linearis",
            "nitro-review-feedback",
            "openspec-tasks",
            "plan",
            "project-health-brief",
            "research",
            "research-content",
            "research-technical",
            "review",
            "scrutinize",
            "security-review",
            "start-project",
            "writing-skills"
          ]
        }
      ]
    },
    "cloudflare": {
      "skills": [
        {
          "url": "https://github.com/cloudflare/skills.git",
          "ref": "main",
          "basePath": "skills",
          "names": [
            "agents-sdk",
            "cloudflare",
            "durable-objects",
            "web-perf",
            "workers-best-practices",
            "wrangler"
          ]
        }
      ]
    },
    "fullscript": {
      "skills": [
        {
          "url": "https://git.fullscript.io/ai/skills.git",
          "ref": "main",
          "basePath": ".",
          "names": ["gitlab-ci", "glab-cli", "legoland", "terraform"]
        }
      ]
    }
  }
}

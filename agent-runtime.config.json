{
  "version": 1,
  "runtime": {
    "canonicalSkillsDir": "~/.agents/skills",
    "skillSymlinkTargets": [
      "~/.claude/skills"
    ],
    "canonicalAgentsDir": "~/.agents/agents",
    "agentSymlinkTargets": {
      "codex": "~/.codex/agents",
      "claude": "~/.claude/agents",
      "opencode": "~/.config/opencode/agents"
    },
    "instructionSymlinkTargets": {
      "agents": "~/.agents",
      "claude": "~/.claude"
    }
  },
  "profiles": {
    "personal": {
      "include": [
        "personal-skills",
        "cloudflare"
      ],
      "paths": [
        "AGENTS.md",
        "rules/agent-surface-routing.md",
        "rules/command-and-tools.md",
        "rules/confidence.md",
        "rules/dependency-security.md",
        "rules/docs-and-specs.md",
        "rules/feature-delivery.md",
        "rules/git-and-review.md",
        "rules/handoff-and-resume.md",
        "rules/investigation-and-implementation.md",
        "rules/session-startup.md"
      ]
    },
    "work": {
      "include": [
        "personal-skills",
        "cloudflare",
        "fullscript"
      ],
      "paths": [
        "AGENTS.md",
        "rules/agent-surface-routing.md",
        "rules/ci-infra-and-cloudflare.md",
        "rules/command-and-tools.md",
        "rules/confidence.md",
        "rules/dependency-security.md",
        "rules/docs-and-specs.md",
        "rules/feature-delivery.md",
        "rules/fullscript/nitro-review.md",
        "rules/git-and-review.md",
        "rules/handoff-and-resume.md",
        "rules/investigation-and-implementation.md",
        "rules/session-startup.md"
      ]
    }
  },
  "agentModelMappings": {
    "implementer": {
      "codex": {
        "model": "gpt-5.4",
        "reasoning": "high"
      },
      "claude": {
        "model": "sonnet"
      },
      "opencode": {
        "model": "anthropic/claude-sonnet"
      }
    },
    "local-review": {
      "codex": {
        "model": "gpt-5.5",
        "reasoning": "xhigh"
      },
      "claude": {
        "model": "opus"
      },
      "opencode": {
        "model": "anthropic/claude-opus"
      }
    },
    "github-review": {
      "codex": {
        "model": "gpt-5.5",
        "reasoning": "xhigh"
      },
      "claude": {
        "model": "opus"
      },
      "opencode": {
        "model": "anthropic/claude-opus"
      }
    },
    "gitlab-review": {
      "codex": {
        "model": "gpt-5.5",
        "reasoning": "xhigh"
      },
      "claude": {
        "model": "opus"
      },
      "opencode": {
        "model": "anthropic/claude-opus"
      }
    }
  },
  "blocks": {
    "personal-skills": {
      "skills": [
        {
          "localPath": "skills",
          "names": [
            "*"
          ]
        }
      ]
    },
    "cloudflare": {
      "skills": [
        {
          "url": "https://github.com/cloudflare/skills.git",
          "ref": "main",
          "basePath": "skills",
          "names": [
            "agents-sdk",
            "cloudflare",
            "durable-objects",
            "sandbox-sdk",
            "web-perf",
            "workers-best-practices",
            "wrangler"
          ]
        }
      ]
    },
    "fullscript": {
      "skills": [
        {
          "url": "https://git.fullscript.io/ai/skills.git",
          "ref": "main",
          "basePath": ".",
          "names": [
            "glab-cli",
            "glab-mr-create",
            "glab-stacked-diffs",
            "legoland",
            "terraform"
          ]
        }
      ]
    }
  }
}

# AI tools installed through Homebrew. Homebrew does not pin versions, so these
# track the latest release; mise pins the rest (see runtime.configs.mise in
# ax.config.json). Install with bin/bootstrap. The herdr-app cask installs only
# the Herdr desktop app; bin/bootstrap installs herdr-core (hc) separately.
brew "mise"
cask "herdr-app"
cask "claude-code"
cask "codex"
